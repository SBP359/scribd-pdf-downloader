{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "author": "sbp359",
  "browser_specific_settings": {
    "gecko": {
      "id": "scribd-pdf-downloader@sbp359.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "constants.js",
        "content.js"
      ],
      "matches": [
        "https://*.scribd.com/document/*",
        "https://*.scribd.com/doc/*",
        "https://*.scribd.com/embeds/*",
        "https://*.scribd.com/embed/*"
      ],
      "run_at": "document_end"
    }
  ],
  "description": "Prepare Scribd documents you can access for saving as PDFs.",
  "host_permissions": [
    "https://*.scribd.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "Scribd Downloader",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.0.0"
}
